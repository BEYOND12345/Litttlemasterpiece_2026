# Required: Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Required: Google Gemini AI (for intelligent artwork enhancement and analysis)
# Get your free API key at: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Recommended: Remove.bg API (for professional background removal)
# Free tier: 50 images/month. Get key at: https://www.remove.bg/api
# Falls back to local processing if not provided
VITE_REMOVEBG_API_KEY=your_removebg_api_key_here

# Required: Cloudinary Configuration (for realistic product mockups)
# Get your free account at: https://cloudinary.com/users/register/free
# After signing up, find your credentials at: https://console.cloudinary.com/settings
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
VITE_CLOUDINARY_API_KEY=your_cloudinary_api_key_here
VITE_CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
# Optional: Upload preset for unsigned uploads (recommended for production)
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset_here

# Optional: Gelato Print API (for physical product fulfillment)
# Only needed if you want to enable physical product ordering
VITE_GELATO_API_KEY=your_gelato_api_key_here
VITE_GELATO_STORE_ID=your_gelato_store_id_here
