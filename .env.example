# BROWSER configuration only.
#
# Every VITE_ variable is compiled INTO the public JavaScript bundle and can be
# read by anyone who opens the site. Only put values here that are public by
# design. Never give a secret a VITE_ name, even one the code does not read.

# Supabase project URL and anon (public) key. Row Level Security is what
# protects the data, not the secrecy of this key.
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional, old studio only: Cloudinary cloud name and an UNSIGNED upload
# preset (both public by design). There is no Cloudinary API key or secret in
# the browser any more.
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset_here

# ---------------------------------------------------------------------------
# SERVER secrets do NOT go in this file. They are Supabase Edge Function
# secrets, set with `supabase secrets set` (docs/PAYMENTS.md), and are only
# ever read by the functions in supabase/functions:
#
#   STRIPE_SECRET_KEY        Stripe secret key (sk_test_... / sk_live_...)
#   STRIPE_WEBHOOK_SECRET    signing secret of the stripe-webhook endpoint (whsec_...)
#   GELATO_API_KEY           Gelato API key
#   GELATO_ORDER_TYPE        "order" to print for real; anything else makes drafts
#   GELATO_WEBHOOK_SECRET    random token in the gelato-webhook URL
#   SITE_URL                 https://your-site, for Stripe's return links and CORS
#   ALLOWED_ORIGINS          optional extra origins for CORS, comma separated
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to the functions by
# Supabase. The service role key must never appear in this file.
#
# Gemini, remove.bg, Replicate and Gelato used to be called from the browser
# with keys in VITE_ variables; those calls are removed.
